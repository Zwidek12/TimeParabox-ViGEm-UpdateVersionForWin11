<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Zwidek12; fork of Aldaviva/TimeParabox</Authors>
    <Description>TimeParabox for Windows 11 — ViGEmBus instead of broken ScpVBus</Description>
    <NoWarn>CS8524</NoWarn>
    <RollForward>major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="mwinapi" Version="0.3.0.5" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

</Project>
